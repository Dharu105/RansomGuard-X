# Local development (direct FastAPI)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/events

# Vercel production (same-origin via root vercel.json rewrites):
# leave both unset, or set empty, so the browser uses /api and wss://<host>/ws/events
# VITE_API_BASE_URL=
# VITE_WS_URL=
